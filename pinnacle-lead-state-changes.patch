+
+    message = (
+        f"🔔 INTERESTED LEAD — Pinnacle Block B\n\n"
+        f"Lead ID:  {lead_id}\n"
+        f"Name:     {name}\n"
+        f"Phone:    +{phone}\n"
+        f"Signal:   {sentiment} / {action}\n"
+        f"Score:    {score}\n"
+        f"Reply:    \"{reply_text[:200]}\""
+    )
+
+    try:
+        resp = requests.post(
+            f"{WASENDER_BASE_URL}/send-message",
+            headers={"Authorization": f"Bearer {WASENDER_API_KEY}"},
+            json={
+                "session": WASENDER_SESSION,
+                "to":      INTEREST_ALERT_PHONE,
+                "type":    "text",
+                "text":    {"body": message},
+            },
+            timeout=15,
+        )
+        resp.raise_for_status()
+
+        # Mark alert as sent so it doesn't fire again for this lead
+        db.update_lead_state(lead_id, {"interest_alert_sent_at": "NOW()"})
+        log.info(f"Interest alert sent for {lead_id} ({name}) → {INTEREST_ALERT_PHONE}")
 
+    except Exception as e:
