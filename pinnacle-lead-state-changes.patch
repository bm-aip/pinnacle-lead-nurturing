+def _notify_if_interested(lead: dict, result: dict, reply_text: str):
+    """
+    Fires ONE WhatsApp alert to INTEREST_ALERT_PHONE when a lead first shows
+    a meaningful positive signal — WARM, NEAR_CLOSE, accelerate, or escalate.
+
+    Dedup: checks lead_state.interest_alert_sent_at. If already set, skips.
+    This means the alert fires at most once per lead, on the first positive
+    reply in the entire nurture lifecycle.
+
+    Alert message format:
+      🔔 INTERESTED LEAD — Pinnacle Block B
+      Lead ID:  [lead_id]
+      Name:     [name]
+      Phone:    +[phone]
+      Signal:   [sentiment] / [action]
+      Score:    [score]
+      Reply:    "[last reply text]"
+    """
+    TRIGGER_SENTIMENTS = {"WARM", "NEAR_CLOSE"}
+    TRIGGER_ACTIONS    = {"accelerate", "escalate"}
+
+    sentiment = result.get("sentiment", "")
+    action    = result.get("action", "")
+
+    # Check trigger condition
+    if sentiment not in TRIGGER_SENTIMENTS and action not in TRIGGER_ACTIONS:
+        return
+
+    lead_id = lead.get("lead_id", "UNKNOWN")
+    if lead_id == "UNKNOWN":
+        return
+
+    # Dedup — only fire once per lead.
+    # Re-fetch fresh from DB (not the stale dict from webhook entry)
+    # so a concurrent webhook can't bypass the check.
